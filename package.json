{
  "name": "html2wp-desktop",
  "version": "1.0.21",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle:mac": "tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "test": "vitest run",
    "test:runtime": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "schema:codex": "codex app-server generate-ts --experimental --out schemas/codex",
    "test:ui": "npm run build && playwright test",
    "bundle:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis -- --locked",
    "bundle:windows:local": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --config src-tauri/tauri.windows-local.conf.json -- --locked",
    "version:set": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.55.0"
  }
}
